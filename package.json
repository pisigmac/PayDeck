{
  "name": "paydeck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PayDeck shared billing / Razorpay microservice",
  "license": "MIT",
  "scripts": {
    "start": "node dist/entrypoints/node.js",
    "start:bun": "bun run src/entrypoints/bun.ts",
    "dev": "wrangler dev src/entrypoints/cloudflare.ts",
    "deploy": "wrangler deploy src/entrypoints/cloudflare.ts",
    "db:local": "wrangler d1 migrations apply paydeck --local",
    "db:remote": "wrangler d1 migrations apply paydeck --remote",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.7.2",
    "js-yaml": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
